{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bloodborne logical-object contract v2 (five-family POC)",
  "type": "object",
  "required": ["schemaVersion", "transform_contract", "families"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 2},
    "transform_contract": {"const": "transform-v2.json"},
    "families": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/family"}}
  },
  "$defs": {
    "cell": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": -64, "maximum": 64}},
    "point": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -64, "maximum": 64}},
    "box": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number", "minimum": -64, "maximum": 64}},
    "boxes": {"type": "object", "required": ["boxes"], "additionalProperties": false, "properties": {"boxes": {"type": "array", "items": {"$ref": "#/$defs/box"}}}},
    "pattern": {
      "type": "object", "required": ["components"], "additionalProperties": false,
      "properties": {"components": {"type": "array", "minItems": 1, "items": {
        "type": "object", "required": ["id", "properties", "offset"], "additionalProperties": false,
        "properties": {"id": {"type": "string", "pattern": "^minecraft:[a-z0-9_]+$"}, "properties": {"type": "object", "additionalProperties": {"type": "string"}}, "offset": {"$ref": "#/$defs/cell"}}
      }}}
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["rotation", "render_mesh", "selection_footprint", "collision_footprint", "interaction_footprint", "migration_source_pattern"],
      "properties": {
        "rotation": {"enum": [0,90,180,270]},
        "render_mesh": {"type": "object", "additionalProperties": false, "required": ["id", "bounds", "offset"], "properties": {"id": {"type": "string"}, "bounds": {"$ref": "#/$defs/box"}, "offset": {"$ref": "#/$defs/point"}}},
        "selection_footprint": {"$ref": "#/$defs/boxes"},
        "collision_footprint": {"$ref": "#/$defs/boxes"},
        "interaction_footprint": {"type": "object", "required": ["cells"], "additionalProperties": false, "properties": {"cells": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/cell"}}}},
        "migration_source_pattern": {"type": "array", "items": {"$ref": "#/$defs/pattern"}}
      }
    },
    "family": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "canonical_anchor", "placement_policy", "rotations", "mirror_policy", "collision_policy", "states"],
      "properties": {
        "id": {"enum": ["o_dead_tree_planter", "o_cases_0", "o_wall_deco_1", "o_iron_gate", "o_iron_railing"]},
        "canonical_anchor": {"type": "object", "required": ["cell", "pivot"], "additionalProperties": false, "properties": {"cell": {"$ref": "#/$defs/cell"}, "pivot": {"const": [0.5,0,0.5]}}},
        "placement_policy": {"enum": ["FLOOR", "WALL_ADJACENT"]},
        "rotations": {"const": [0,90,180,270]},
        "mirror_policy": {"const": "ROTATE_ONLY"},
        "collision_policy": {"enum": ["NONE", "SIMPLE_BOX", "TWO_BOX", "TRUNK", "POST", "FENCE", "WALL", "DOOR", "GATE", "STAIRS"]},
        "collision_justification": {"type": "string", "minLength": 1},
        "states": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/state"}}
      }
    }
  }
}
