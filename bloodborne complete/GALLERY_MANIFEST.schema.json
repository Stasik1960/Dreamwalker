{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Dreamwalker immutable baseline gallery manifest",
 "type":"object",
 "required":["schema","catalog_sha256","jar_sha256","source_world_sha256","baseline_archive_sha256","dimension_changes","platforms"],
 "properties":{
  "schema":{"const":"dreamwalker-gallery-v1"},
  "catalog_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "jar_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "source_world_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "baseline_archive_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
  "dimension_changes":{"type":"array"},
  "platforms":{"type":"array","items":{
   "type":"object","required":["id","name_ru","dimension","source_sample","root","parts","edit_bounds","technical_cells","supports"],
   "properties":{
    "id":{"type":"string","pattern":"^[0-9]{5}$"},
    "name_ru":{"type":"string"},
    "dimension":{"type":"string"},
    "source_sample":{"type":"object","required":["states","models","positions","selected_variants"]},
    "root":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"integer"}},
    "parts":{"type":"array"},
    "edit_bounds":{"type":"object","required":["min","max"]},
    "technical_cells":{"type":"array"},
    "supports":{"type":"array"}
   }
  }}
 }
}
